# Bu dosyayı .env olarak kopyalayıp değerleri doldur (YEREL TEST için).
# .env dosyası .gitignore ile korunur; asla commit'lenmez.
#
# Yerel testte ortam değişkenlerini yüklemek için (PowerShell):
#   Get-Content .env | ForEach-Object { if ($_ -match '^\s*([^#=]+)=(.*)$') { [Environment]::SetEnvironmentVariable($matches[1].Trim(), $matches[2].Trim()) } }
# Git Bash / Linux / macOS:
#   export $(grep -v '^#' .env | xargs)

CLAUDE_CODE_OAUTH_TOKEN=buraya_claude_setup_token_ciktisi
TELEGRAM_BOT_TOKEN=buraya_botfather_token
TELEGRAM_CHAT_ID=@kanal_kullanici_adi_veya_-100xxxxxxxxxx
TELEGRAM_ADMIN_CHAT_ID=senin_ozel_chat_id

# Opsiyonel: soru-cevap asistanının bir GRUPTA da (kanalda değil) çalışması
# için. Grup üyeleri admin ile TAMAMEN AYNI yetkiye sahip olur (alarm/mail/
# portföy dahil) — sadece güvendiğin bir gruba ekle. Değerini bulmak için:
# python asistan.py --sohbetleri-listele (önce gruba bir mesaj at).
TELEGRAM_GRUP_CHAT_ID=grubun_chat_id_si_-100xxxxxxxxxx

# Soru-cevap asistanının zamanlı mail özelliği için (Gmail SMTP, ücretsiz).
# SMTP_UYGULAMA_SIFRESI normal Gmail şifren DEĞİL: Google hesabında 2 adımlı
# doğrulamayı açtıktan sonra myaccount.google.com/apppasswords adresinden
# üretilen 16 haneli "uygulama şifresi".
SMTP_GMAIL_ADRES=senin_gonderen_gmail_adresin@gmail.com
SMTP_UYGULAMA_SIFRESI=on_alti_haneli_uygulama_sifresi
ALICI_EMAIL=maillerin_gidecegi_adres@ornek.com
